# Environment for vllm.service. Sourced by systemd, not by the application.
#
# VRAM budget on the 16 GB card:
#   Qwen3-8B AWQ weights        5-6 GB
#   KV cache (8k ctx, small bs) 2-3 GB
#   embedding model             0.5-1 GB   (only if you move it off the CPU)
#   headroom                    ~4 GB
#
# 0.80 leaves room for the embedding model and for fragmentation. Raise it only
# after measuring; an OOM here takes the whole pipeline down, and the retry
# backoff will then hammer a dead endpoint.

MODEL=Qwen/Qwen3-8B-AWQ
SERVED_MODEL_NAME=Qwen3-8B-AWQ
PORT=8000
HOST=127.0.0.1

GPU_MEMORY_UTILIZATION=0.80
MAX_MODEL_LEN=8192
# Body is capped at ~800 tokens and the output at 512, so a long context buys
# nothing here and costs KV cache.
MAX_NUM_SEQS=8
QUANTIZATION=awq_marlin
DTYPE=float16

# Structured outputs need no server flag: vLLM removed
# --guided-decoding-backend in 0.12.0 and picks the backend itself. The
# request carries the schema (llm/client.py sends structured_outputs.json).

HF_HOME=/var/lib/triage/models
VLLM_LOGGING_LEVEL=INFO
