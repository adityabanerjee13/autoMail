# vLLM on Intel Arc (XPU). Used by deploy/vllm-xpu.compose.yml.
#
# This is the Windows/Arc deployment. deploy/vllm.env is the Linux/NVIDIA one.
# Same model and same weights; four differences, each one a thing that fails
# outright rather than a preference:
#
#   1. QUANTIZATION=awq, not awq_marlin. Marlin is a CUDA kernel.
#   2. ATTENTION_BACKEND=TRITON_ATTN. The default XPU FlashAttention kernel is
#      Xe2/Xe3-only and this GPU is Xe-LPG. See the comment below.
#   3. GPU_MEMORY_UTILIZATION is much lower, because the "GPU memory" here is
#      system RAM behind a WSL2 VM. See the arithmetic below.
#   4. No --dtype override; the XPU backend picks its own compute dtype.
#
# The handoff's hardware note says 18 GB of system RAM. This box actually has
# 31.5 GB, but Docker Desktop's WSL VM gets half of it, and that half is the
# real ceiling for everything below -- so the effective budget is tighter than
# the handoff assumed, not looser.

MODEL=Qwen/Qwen3-8B-AWQ
SERVED_MODEL_NAME=Qwen3-8B-AWQ
PORT=8000

# The handoff says 0.80. That is right for a card with 16 GB of dedicated VRAM
# and wrong here, because this "GPU memory" is system RAM behind a WSL2 VM:
#
#   device reports          16.44 GiB   (shared, not dedicated)
#   WSL VM total            15.37 GiB   (the real ceiling; 50% of a 31.5 GiB host)
#   RAM vLLM measured free  12.07 GiB
#   0.80 would ask for      13.15 GiB   -> more than exists
#
# At 0.80 the engine loads the weights, finishes torch.compile, and is then
# SIGKILLed during the profiling run with no error in its own log -- exit 137,
# and Docker reports OOMKilled:false because the kill came from the VM kernel,
# not the container cgroup. Silent death after a clean-looking load is the
# signature; if you see it, this is the number to change.
#
#   0.55 * 16.44 = 9.04 GiB: 5.71 weights + ~3.3 for activations and KV cache.
# Raise it only after checking `docker info | grep "Total Memory"` -- and note
# that giving the VM more RAM via %USERPROFILE%\.wslconfig raises this ceiling.
GPU_MEMORY_UTILIZATION=0.55
MAX_MODEL_LEN=8192
# Body is capped at ~800 tokens and output at 512, so a longer context buys
# nothing and costs KV cache. The model card allows 40960.
MAX_NUM_SEQS=8

# vLLM's default XPU attention is a FlashAttention-2 kernel that is built
# for Xe2/Xe3 only. This GPU is Xe-LPG (arch version 12.74,
# has_subgroup_2d_block_io=False), so every generation request dies with
#   RuntimeError: Only XE2/XE3 cutlass kernel is supported currently.
# -- at request time, not at startup: the server loads, allocates its KV
# cache, reports "Application startup complete", and then 500s on the
# first completion. The Triton backend has no such restriction and is
# numerically fine here. Drop this on Xe2/Xe3 or on NVIDIA, where the
# FlashAttention path is faster.
ATTENTION_BACKEND=TRITON_ATTN
QUANTIZATION=awq

# Structured outputs need no server flag: vLLM removed
# --guided-decoding-backend in 0.12.0 and picks the backend itself. The
# request carries the schema (llm/client.py sends structured_outputs.json).

# Level Zero needs the WSL paravirtualized driver on the library path, and
# without ONEAPI_DEVICE_SELECTOR a machine with more than one Intel device can
# pick the wrong one. Setting LD_LIBRARY_PATH here is safe only because the
# image's entrypoint sources oneAPI setvars.sh, which appends to it -- see the
# comment in vllm-xpu.compose.yml about never overriding that entrypoint.
LD_LIBRARY_PATH=/usr/lib/wsl/lib
ONEAPI_DEVICE_SELECTOR=level_zero:0
VLLM_WORKER_MULTIPROC_METHOD=spawn

# oneCCL exchanges GPU handles between ranks, and its default mechanisms both
# want to enumerate render nodes under /dev/dri. WSL2 has no /dev/dri -- the
# GPU arrives as /dev/dxg -- so oneCCL dies at startup with
#   CCL_ERROR ze_fd_manager.cpp:144 init_device_fds: condition dir failed
# and takes the whole engine down before a single weight is loaded. The socket
# exchange does not touch /dev/dri. This costs nothing here: with one device
# and tensor_parallel_size=1 there is no collective traffic to speed up.
CCL_ZE_IPC_EXCHANGE=sockets
CCL_ATL_TRANSPORT=ofi

# Intel's compute runtime caps a *single* allocation well below total memory.
# Measured on this device: cumulative allocation past 12 GiB is fine, but any
# one allocation over 1.0 GiB fails with
#   torch.OutOfMemoryError: Tried to allocate 1.16 GiB ... 16.42 GiB is free
# which reads like an OOM and is not one -- note how much it says is free, and
# that only 16 MiB was allocated at the time. vLLM hits it loading a weight
# shard, long before the KV cache. These two keys lift the restriction; with
# them the same device allocates 8 GiB in one block.
NEOReadDebugKeys=1
AllowUnrestrictedSize=1
